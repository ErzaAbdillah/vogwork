{
  "extends": "@vogwork/tsconfig/base.json",
  "compilerOptions": {
    "allowJs": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src", "tests", "*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
